# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000   # international format, no "+"
NEXT_PUBLIC_STORE_NAME=WireFence Supplies

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ---------- Admin sessions ----------
ADMIN_SESSION_SECRET=generate-a-long-random-string-min-32-chars
ADMIN_SESSION_DAYS=7                      # 7 to 14
ADMIN_OTP_TTL_MINUTES=10

# ---------- Cloudinary ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- M-Pesa Daraja (sandbox) ----------
MPESA_ENV=sandbox                         # sandbox | production
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379                    # sandbox default
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline for Till (v2)
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-URL/api/mpesa/callback   # must be public HTTPS (use ngrok locally)
MPESA_CALLBACK_SECRET=another-long-random-string   # appended as ?token= and checked on callback

# ---------- Email (pick one provider) ----------
EMAIL_PROVIDER=resend                     # resend | smtp
EMAIL_FROM="WireFence Supplies <orders@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# ---------- Maps ----------
# Leaflet + OpenStreetMap tiles need no key. Optional Mapbox tiles:
NEXT_PUBLIC_MAPBOX_TOKEN=
